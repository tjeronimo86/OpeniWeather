// Prozeduraler Wetterhimmel (AGSL, Android 13+).
// Haelt sich an die ES2-Regeln: nur konstante for-Schleifen, kein while.
// Dieselbe Datei wird in tools/preview per WebGL gerendert.
uniform vec2  uRes;     // Aufloesung in Pixeln
uniform float uTime;    // Sekunden (Niederschlag, Sterne, Blitze)
uniform float uCloudTime; // Sekunden fuer Wolken und Nebel
uniform float uCloud;   // Wolkenmenge 0..1
uniform float uGrey;    // Wolken-Dunkelheit 0..1
uniform float uRain;    // Regenstaerke 0..1
uniform float uSnow;    // Schneestaerke 0..1
uniform float uFog;     // Nebel 0..1
uniform float uStorm;   // Blitze 0..1
uniform float uDay;     // 0 Nacht .. 1 Tag
uniform float uDusk;    // 0..1 Daemmerungsfaerbung
uniform vec2  uSun;     // Sonne/Mond in UV (y nach unten, x 0..1)
uniform float uMoon;    // Mondphase 0..1 (0 Neumond, .5 Vollmond)

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}
float hash21(vec2 p) {
    vec3 q = fract(vec3(p.x, p.y, p.x) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}
float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        // Rotation verhindert sichtbare Rasterachsen
        p = vec2(p.x * 1.6 - p.y * 1.2, p.x * 1.2 + p.y * 1.6) + 7.3;
        a *= 0.5;
    }
    return v;
}

// Wolkendichte: grosse Form + aufgewirbelte Kante
float cloudField(vec2 p, float cover, float seed) {
    vec2 q = p + seed;
    float warp = fbm(q * 0.8 + vec2(uCloudTime * 0.012, -uCloudTime * 0.007));
    float n = fbm(q + 0.34 * vec2(warp, warp * 0.6));
    // Kleine Quellformen fressen die Kante an, das macht Cumulus statt Schleier
    float billow = abs(noise(q * 5.0 + warp) - 0.5) * 2.0 + 0.5 * abs(noise(q * 11.0 - warp) - 0.5) * 2.0;
    n -= (1.0 - smoothstep(0.35, 0.75, n)) * billow * 0.13;
    float edge = 0.74 - cover * 0.66;
    return smoothstep(edge, edge + 0.075 + cover * 0.20, n);
}

vec3 skyColor(float y) {
    vec3 dayTop  = vec3(0.145, 0.400, 0.760);
    vec3 dayLow  = vec3(0.520, 0.740, 0.930);
    vec3 nightTop = vec3(0.016, 0.031, 0.094);
    vec3 nightLow = vec3(0.075, 0.130, 0.270);
    vec3 duskTop = vec3(0.210, 0.250, 0.520);
    vec3 duskLow = vec3(0.980, 0.580, 0.360);
    vec3 greyTop = vec3(0.340, 0.410, 0.490);
    vec3 greyLow = vec3(0.590, 0.650, 0.710);
    vec3 top = mix(nightTop, dayTop, uDay);
    vec3 low = mix(nightLow, dayLow, uDay);
    top = mix(top, duskTop, uDusk);
    low = mix(low, duskLow, uDusk);
    float g = uGrey * uCloud;
    float lum = mix(0.16, 1.0, uDay);
    top = mix(top, greyTop * lum, g);
    low = mix(low, greyLow * lum, g);
    return mix(top, low, smoothstep(0.0, 1.0, y));
}

vec3 stars(vec2 uv) {
    vec3 c = vec3(0.0);
    for (int i = 0; i < 2; i++) {
        float s = 34.0 + float(i) * 26.0;
        vec2 g = uv * s;
        vec2 id = floor(g);
        float h = hash21(id + float(i) * 17.0);
        if (h > 0.90) {
            vec2 o = vec2(hash21(id + 1.7), hash21(id + 4.1)) - 0.5;
            float d = length(fract(g) - 0.5 - o * 0.7);
            float tw = 0.6 + 0.4 * sin(uTime * (1.0 + h * 3.0) + h * 80.0);
            c += vec3(0.86, 0.91, 1.0) * smoothstep(0.11, 0.0, d) * tw * (h - 0.88) * 16.0;
        }
    }
    return c;
}

// Mond mit Phase und leichter Oberflaeche. Gibt Farbe (rgb) und Deckung (a).
vec4 moon(vec2 uv, vec2 c, float r) {
    vec2 d = (uv - c) / r;
    float l = length(d);
    float glow = 0.20 * exp(-1.4 * max(l - 1.0, 0.0));
    if (l > 1.02) return vec4(vec3(0.60, 0.68, 0.85) * glow * 0.5, 0.0);
    float z = sqrt(max(1.0 - l * l, 0.0));
    float a = uMoon * 6.28318;
    vec3 sunDir = vec3(sin(a), 0.0, -cos(a));
    float lit = smoothstep(-0.05, 0.08, dot(vec3(d.x, d.y, z), sunDir));
    float maria = 0.74 + 0.26 * fbm(d * 2.4 + 3.0);
    float disc = smoothstep(1.0, 0.97, l);
    vec3 col = vec3(0.97, 0.95, 0.88) * maria * lit + vec3(0.09, 0.11, 0.17) * (1.0 - lit);
    return vec4(col, disc * (0.25 + 0.75 * lit));
}

float rainLayer(vec2 uv, float scale, float speed, float seed) {
    vec2 p = uv * scale;
    p.x += p.y * 0.07;
    float col = floor(p.x);
    float h = hash11(col + seed);
    float y = p.y * 0.075 - uTime * speed * (0.8 + 0.5 * h) + h * 37.0;
    float cell = floor(y);
    float f = fract(y);
    float present = step(1.0 - uRain * 0.75, hash21(vec2(col, cell) + seed));
    float head = smoothstep(0.42, 0.0, f) * smoothstep(0.0, 0.015, f);
    float x = abs(fract(p.x) - 0.5);
    return present * head * smoothstep(0.075, 0.0, x);
}

float snowLayer(vec2 uv, float scale, float speed, float seed) {
    vec2 p = uv * scale;
    p.y -= uTime * speed;
    p.x += 0.35 * sin(p.y * 0.8 + seed + uTime * 0.25);
    vec2 id = floor(p);
    float h = hash21(id + seed);
    if (h > 0.25 + uSnow * 0.70) return 0.0;
    vec2 o = vec2(hash21(id + 3.1), hash21(id + 9.7)) * 0.6 + 0.2;
    float r = 0.05 + 0.09 * hash21(id + 5.5);
    return smoothstep(r, r * 0.25, length(fract(p) - o));
}

// Blitze: alle paar Sekunden pseudozufaellig, mit Doppelflackern
float flashAt(float t) {
    float slot = floor(t / 5.0);
    float h = hash11(slot + 3.0);
    if (h > 0.25 + uStorm * 0.45) return 0.0;
    float start = hash11(slot + 11.0) * 3.6;
    float x = t - slot * 5.0 - start;
    if (x < 0.0) return 0.0;
    return exp(-x * 9.0) + 0.75 * exp(-max(x - 0.20, 0.0) * 11.0) * step(0.20, x);
}
float bolt(vec2 uv, float aspect, float t) {
    float slot = floor(t / 5.0);
    float x0 = (0.2 + 0.6 * hash11(slot + 21.0)) * aspect;
    float y = uv.y;
    float end = 0.42 + 0.3 * hash11(slot + 5.0);
    if (y > end) return 0.0;
    float wob = (fbm(vec2(y * 7.0, slot)) - 0.5) * 0.34
              + (noise(vec2(y * 42.0, slot * 3.0)) - 0.5) * 0.045;
    float d = abs(uv.x - x0 - wob);
    return (smoothstep(0.0045, 0.0005, d) + 0.0035 / (d + 0.012)) * smoothstep(end, end - 0.08, y);
}

half4 main(vec2 frag) {
    float aspect = uRes.x / uRes.y;
    vec2 uv = vec2(frag.x / uRes.y, frag.y / uRes.y);  // y: 0 oben .. 1 unten
    float y = uv.y;

    vec3 col = skyColor(y);

    // Sterne nur nachts und wo wenig Wolken sind
    col += stars(uv + vec2(uTime * 0.0008, 0.0)) * (1.0 - uDay) * (1.0 - smoothstep(0.55, 0.95, uCloud)) * smoothstep(0.92, 0.25, y);

    // Sonne und Mond sitzen hinter den Wolken
    vec2 sun = vec2(uSun.x * aspect, uSun.y);
    float sd = length(uv - sun);
    float sunGlow = 0.0;
    if (uDay > 0.02) {
        float vis = uDay * (1.0 - 0.72 * uCloud * uGrey);
        sunGlow = exp(-sd * 3.4) * 0.30 + exp(-sd * 16.0) * 0.45;
        vec3 tint = mix(vec3(1.0, 0.96, 0.84), vec3(1.0, 0.70, 0.42), uDusk);
        col += tint * sunGlow * vis;
        col = mix(col, vec3(1.0, 0.99, 0.94), smoothstep(0.033, 0.022, sd) * vis);
    }
    if (uDay < 0.5) {
        vec4 m = moon(uv, sun, 0.052);
        float k = 1.0 - uDay * 2.0;
        col += m.rgb * (1.0 - m.a) * k;
        col = mix(col, m.rgb, m.a * k);
    }

    // Zwei Wolkenebenen mit Parallaxe. Entfernte Wolken: flacher, heller.
    if (uCloud > 0.01) {
        vec3 lightCol = mix(vec3(0.34, 0.40, 0.54), vec3(1.0, 1.0, 1.0), uDay);
        lightCol = mix(lightCol, vec3(1.0, 0.84, 0.72), uDusk * 0.8);
        vec3 shadeCol = mix(vec3(0.09, 0.12, 0.20), vec3(0.62, 0.70, 0.80), uDay);
        shadeCol = mix(shadeCol, vec3(0.42, 0.33, 0.48), uDusk * 0.8);
        vec3 greyLight = mix(vec3(0.14, 0.16, 0.21), vec3(0.74, 0.77, 0.81), uDay);
        vec3 greyShade = mix(vec3(0.05, 0.06, 0.09), vec3(0.30, 0.34, 0.40), uDay);
        lightCol = mix(lightCol, greyLight, uGrey);
        shadeCol = mix(shadeCol, greyShade, uGrey);

        // laeuft zur Sonne hin auf 0 aus, sonst entsteht dort ein Stern-Artefakt
        float sunLen = length(sun - uv) + 0.0001;
        vec2 toSun = (sun - uv) / sunLen * smoothstep(0.0, 0.30, sunLen);
        // Wolken sitzen eher oben, unten wird der Himmel frei
        float band = mix(smoothstep(0.92, 0.22, y), 1.0, smoothstep(0.55, 0.95, uCloud));

        vec2 pFar = vec2(uv.x * 2.1 + uCloudTime * 0.008, uv.y * 3.3);
        float dFar = cloudField(pFar, uCloud * 0.85 * band, 11.0);
        float dFar2 = cloudField(pFar + toSun * 0.11, uCloud * 0.85 * band, 11.0);
        float shFar = clamp(0.62 + (dFar - dFar2) * 1.15, 0.0, 1.0);
        col = mix(col, mix(shadeCol, lightCol, shFar), dFar * 0.72);

        vec2 pNear = vec2(uv.x * 1.15 + uCloudTime * 0.017, uv.y * 1.75);
        float dNear = cloudField(pNear, uCloud * band, 3.0);
        float dNear2 = cloudField(pNear + toSun * 0.09, uCloud * band, 3.0);
        float shNear = clamp(0.60 + (dNear - dNear2) * 1.5, 0.0, 1.0);
        // Innere Struktur, damit eine geschlossene Decke nicht flach wirkt
        float inner = fbm(pNear * 1.7 + vec2(uCloudTime * 0.01, 2.0));
        shNear = clamp(shNear + (inner - 0.5) * mix(0.55, 1.35, uGrey), 0.0, 1.0);
        // Unterseiten sind dunkler
        shNear *= mix(1.0, 0.82 + 0.18 * smoothstep(0.75, 0.15, dNear2), dNear);
        // Dichte Kerne etwas dunkler, Raender hell durchleuchtet
        shNear *= mix(1.0, 0.86, smoothstep(0.6, 1.0, dNear) * uGrey);
        float rim = (1.0 - smoothstep(0.0, 0.55, dNear)) * smoothstep(0.02, 0.2, dNear);
        vec3 cloud = mix(shadeCol, lightCol, shNear);
        cloud += rim * sunGlow * 0.9 * vec3(1.0, 0.95, 0.85) * uDay;
        float moonLight = exp(-sd * 5.0) * (1.0 - uDay) * 0.3;
        cloud += vec3(0.42, 0.48, 0.62) * moonLight * (0.4 + rim);
        col = mix(col, cloud, dNear * 0.97);
    }

    // Gewitter
    if (uStorm > 0.01) {
        float f = flashAt(uTime);
        if (f > 0.0) {
            col += vec3(0.72, 0.76, 0.92) * f * 0.62 * (0.55 + 0.45 * fbm(uv * 2.5 + floor(uTime / 5.0)));
            col += vec3(0.92, 0.94, 1.0) * bolt(uv, aspect, uTime) * min(f * 2.2, 1.0);
        }
    }

    // Nebelschwaden liegen unten und ziehen langsam
    if (uFog > 0.01) {
        vec3 fogCol = mix(vec3(0.11, 0.13, 0.18), vec3(0.78, 0.81, 0.84), uDay);
        fogCol = mix(fogCol, vec3(0.86, 0.72, 0.66), uDusk * 0.5);
        float n1 = fbm(vec2(uv.x * 0.9 + uCloudTime * 0.02, uv.y * 4.6));
        float n2 = fbm(vec2(uv.x * 1.5 - uCloudTime * 0.013, uv.y * 8.0 + 4.0));
        float a = smoothstep(0.08, 0.9, y + (n1 - 0.5) * 0.9) * (0.55 + 0.75 * n2);
        col = mix(col, fogCol, clamp(a * uFog + 0.34 * uFog, 0.0, 0.95));
    }

    // Niederschlag vorne
    if (uRain > 0.01) {
        float r = rainLayer(uv, 110.0, 1.3, 1.0) * 0.18
                + rainLayer(uv, 72.0, 1.6, 2.0) * 0.26
                + rainLayer(uv, 44.0, 1.9, 3.0) * 0.34;
        col = mix(col, col * 0.86, uRain * 0.5);
        col += vec3(0.76, 0.84, 0.96) * r * mix(0.36, 1.0, uDay);
    }
    if (uSnow > 0.01) {
        float s = snowLayer(uv, 22.0, 0.55, 1.0) * 0.42
                + snowLayer(uv, 14.0, 0.75, 2.0) * 0.66
                + snowLayer(uv, 8.0, 0.95, 3.0) * 0.92;
        col = mix(col, vec3(0.97, 0.98, 1.0) * mix(0.62, 1.0, uDay), clamp(s, 0.0, 1.0));
    }

    // Leichtes Dithering gegen Banding im Verlauf
    col += (hash21(frag + fract(uTime) * 61.0) - 0.5) / 255.0;
    return half4(half3(col), 1.0);
}
