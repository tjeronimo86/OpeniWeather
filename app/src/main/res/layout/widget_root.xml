<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:contentDescription="Wetter">

    <!-- ViewFlipper ist der einzige Weg zu Dauer-Animation in RemoteViews.
         Beide pausieren von selbst, wenn der Startbildschirm nicht sichtbar ist.
         Der Himmel blendet jedes Bild ueber die volle Wechselzeit ins naechste,
         das alte bleibt so lange stehen: so fliesst die Bewegung statt zu springen. -->
    <ViewFlipper
        android:id="@+id/widget_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="@integer/sky_flip_ms"
        android:inAnimation="@anim/sky_in"
        android:outAnimation="@anim/sky_hold" />

    <!-- Regen, Schnee und Blitze laufen schneller und getrennt von den Wolken -->
    <ViewFlipper
        android:id="@+id/widget_precip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="80" />

    <!-- Text und Symbole bleiben als feste Ebene darueber -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</FrameLayout>
